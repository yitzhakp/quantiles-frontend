---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import { QuestionAndNext } from "../components/QuestionAndNext";
import Config from "../components/Config";


---

<Layout title="Estadísticas - IEA">
	<section class="w-4/5 text-center lg:w-2/3">
		<article>
			<h1
				class="p-5 text-white font-bold flex flex-grow fap-x-4 text-2xl lg:text-4xl lg:p-10"
			>
				Interpretaciones de los cuantiles
			</h1>
			<Badge>Octavo</Badge>
		</article>
		<QuestionAndNext client:load />
	</section>
</Layout>

<style>
	section {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
</style>
